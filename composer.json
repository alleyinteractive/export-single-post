{
    "name": "alleyinteractive/wp-export-single-post",
    "description": "Exports single posts in WordPress WXR format",
    "type": "wordpress-plugin",
    "keywords": [
        "alleyinteractive",
        "wp-export-single-post"
    ],
    "homepage": "https://github.com/alleyinteractive/wp-export-single-post",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Alley Interactive",
            "email": "info@alley.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "alleyinteractive/composer-wordpress-autoloader": "^1.0",
        "alleyinteractive/wp-type-extensions": "^5.0",
        "mantle-framework/support": "^1.15"
    },
    "require-dev": {
        "alleyinteractive/alley-coding-standards": "^2.0",
        "mantle-framework/testkit": "^1.15",
        "rector/rector": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "alleyinteractive/composer-wordpress-autoloader": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "autoload-dev": {
        "psr-4": {
            "Alley\\WP\\Export_Single_Post\\Tests\\": "tests"
        }
    },
    "extra": {
        "wordpress-autoloader": {
            "autoload": {
                "Alley\\WP\\Export_Single_Post\\": "src"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpcbf": "phpcbf .",
        "phpcs": "phpcs .",
        "lint": {
            "0": "@phpcs",
            "2": "@rector"
        },
        "lint:fix": [
            "@rector:fix",
            "@phpcbf"
        ],
        "phpunit": "phpunit",
        "rector:fix": "rector process",
        "rector": "rector process --dry-run",
        "release": "npx @alleyinteractive/create-release@latest",
        "serve": "command -v wp-env >/dev/null 2>&1 || npm install -g @wordpress/env && wp-env start",
        "test": [
            "@lint",
            "@phpunit"
        ]
    }
}